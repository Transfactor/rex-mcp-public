# OAuth: the public URL and the secret that the approval page asks for.
# Make the secret with: node /opt/rex-mcp/dist/main.js token
REX_MCP_PUBLIC_URL=https://mcp.example.com
REX_MCP_OWNER_SECRET=
# Optional static token for tests with curl. Leave it empty in real use.
REX_MCP_TOKEN=
REX_MCP_DISCOVER=1
REX_MCP_DISCOVER_SUFFIX=-rex
# REX_MCP_SERVERS=alpha=https://alpha-rex.<tailnet>.ts.net,beta=https://beta-rex.<tailnet>.ts.net
REX_MCP_HOST=127.0.0.1
REX_MCP_PORT=8787
